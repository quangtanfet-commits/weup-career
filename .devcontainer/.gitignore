# Auto-generated by initialize.sh on first run — contains random
# GUI/VNC passwords. Rotate by deleting and reopening the container.
.env
*.env.bak
*.bak

# Pentest evidence (from /pentest skill) — engagement-scoped, never commit.
.pentest/

# CloakBrowser engagement evidence (from /cloakbrowser skill).
# Contains authorization records + screenshots / traces / HARs. Treat like
# .pentest/ — engagement-scoped, never commit.
.cloakbrowser/

# Playwright UI test evidence (from /ui-test skill).
.evidence/
playwright-report/
test-results/

# /assure skill's machine-readable evidence bundle
.assurance/

# Specula intermediates (TLA+ traces, model-checker logs).
.specula-output/
