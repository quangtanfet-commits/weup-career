# =============================================================
# Todo Application — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =============================================================

# ─── Core ─────────────────────────────────────────────────────
# Random 256-bit key for JWT signing.
# Generate: openssl rand -hex 32
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# development | production | test
ENVIRONMENT=development

# debug | info | warning | error
LOG_LEVEL=info

# ─── Database ─────────────────────────────────────────────────
# SQLite (default for dev/single-node):
DATABASE_URL=sqlite+aiosqlite:////data/app.db

# PostgreSQL (Phase 3 migration — drop-in replacement):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/todos

# ─── Auth Token Lifetimes ──────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_AUTH_REQUESTS=20        # per minute per IP on /auth/*
RATE_LIMIT_API_REQUESTS=200        # per minute per user on /api/*

# ─── CORS & Hosts ─────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (production).
# Development: leave empty → allows all (handled by default).
CORS_ORIGINS=

# Comma-separated list of trusted hosts (production).
ALLOWED_HOSTS=

# ─── Frontend ─────────────────────────────────────────────────
# Must match the backend origin that the SPA talks to.
VITE_API_URL=/api/v1
