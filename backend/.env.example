# =============================================================
# WeUp Career — Backend environment template
# Copy to .env and fill real values. NEVER commit .env.
# Generate secrets:  openssl rand -hex 32
# =============================================================

# --- Core ---
ENVIRONMENT=development          # development | production | test
LOG_LEVEL=info                   # debug | info | warning | error

# JWT signing key (256-bit). REQUIRED.
SECRET_KEY=change-me-openssl-rand-hex-32-0000000000000000000000

# Field-level encryption key for sensitive data (ADR-011). REQUIRED.
# Kept SEPARATE from SECRET_KEY. Rotating it requires re-encryption.
FIELD_ENCRYPTION_KEY=change-me-openssl-rand-hex-32-1111111111111111111

# Production secret-file overrides (Docker secrets) — optional:
# SECRET_KEY_FILE=/run/secrets/secret_key
# FIELD_ENCRYPTION_KEY_FILE=/run/secrets/field_encryption_key

# --- Database (ADR-002: SQLite MVP → Postgres drop-in) ---
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/todos

# --- Auth token lifetimes ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Guardian consent ---
CONSENT_AGE_THRESHOLD=16         # under-X requires guardian consent (NĐ 147/2024)

# --- CORS (comma-separated; empty disables CORS middleware) ---
CORS_ORIGINS=
