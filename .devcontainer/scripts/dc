#!/usr/bin/env bash
# =============================================================================
# dc — one-shot wrapper for users who don't use VS Code Dev Containers
# =============================================================================
# Bundles the host-side `initialize.sh` (which VS Code's `initializeCommand`
# would normally fire) with `docker compose` so you get the same result
# whether you use VS Code or plain `docker compose`.
#
# Usage:
#   bash .devcontainer/scripts/dc up           # initialize + compose up -d
#   bash .devcontainer/scripts/dc down         # compose down
#   bash .devcontainer/scripts/dc logs [args]  # compose logs -f
#   bash .devcontainer/scripts/dc exec [args]  # compose exec dev bash (default)
#   bash .devcontainer/scripts/dc <other>      # passes through to compose
#
# Without this wrapper, `docker compose up` will:
#   • leave .env unset (no random GUI/VNC passwords)
#   • cause Docker to create bind-mount source dirs as ROOT
#     (the cont-init/06-home-ownership hook chowns them, but they'll be
#      missing entirely on the host — pollutes ~/ with stray root-owned
#      directories you can't easily delete).
# =============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DEVC_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
COMPOSE_FILE="$DEVC_DIR/docker-compose.yml"

if [ ! -f "$COMPOSE_FILE" ]; then
    echo "FATAL: docker-compose.yml not found at $COMPOSE_FILE" >&2
    exit 1
fi

# Always run initialize.sh first — it's idempotent (skips if .env exists,
# mkdir -p is no-op when dirs already exist).
bash "$SCRIPT_DIR/initialize.sh"

CMD="${1:-up}"
shift || true

case "$CMD" in
    up)
        # `up -d` by default; pass-through extra args.
        docker compose -f "$COMPOSE_FILE" up -d "$@"
        echo ""
        echo "Container starting. Tail logs with:"
        echo "  bash $0 logs"
        ;;
    down)
        docker compose -f "$COMPOSE_FILE" down "$@"
        ;;
    logs)
        docker compose -f "$COMPOSE_FILE" logs -f "$@"
        ;;
    exec)
        if [ $# -eq 0 ]; then
            docker compose -f "$COMPOSE_FILE" exec dev bash
        else
            docker compose -f "$COMPOSE_FILE" exec dev "$@"
        fi
        ;;
    *)
        # Pass-through for any other compose subcommand (ps, restart, top, …).
        docker compose -f "$COMPOSE_FILE" "$CMD" "$@"
        ;;
esac
