# Server-only base URL for anonymous RSC reads (public career/content).
# Never exposed to the client bundle. In Docker this is the backend service DNS.
BACKEND_INTERNAL_URL=http://localhost:8000

# Browser-facing base URL for authenticated client calls (carries bearer token).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional: point `npm run gen:api` at a running backend instead of the
# hermetic `uv` exporter (e.g. in CI without Python).
# OPENAPI_URL=http://localhost:8000/api/v1/openapi.json
