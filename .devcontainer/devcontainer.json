// ============================================================================
// weup — Dev Container (slim template)
// ============================================================================
// Generated by `make project NAME=weup`.
//
// Runtime scripts (post-create, post-start) are baked into the image at
// /usr/local/bin/devcontainer-*.sh — this template does NOT ship them.
//
// Customization hooks (optional, drop in if you need project-specific logic):
//   .devcontainer/scripts/post-create-hook.sh   — runs after baked post-create
//   .devcontainer/scripts/post-start-hook.sh    — runs after baked post-start
//
// The baked post-create handles: ruflo init, Specula MCP registration, Dark
// Factory skill symlinks, and CLAUDE.skills.md auto-import. Defaults assume
// the published hub.soc.one/library/darkforge:latest image; override via .env if
// needed.
// ============================================================================
{
  "name": "weup",
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/home/administrator/${localWorkspaceFolderBasename}",
  "remoteUser": "administrator",
  "userEnvProbe": "none",
  "overrideCommand": false,
  "customizations": {
    "vscode": {
      "extensions": [
        // ── Core / universal ──────────────────────────────────────────
        "anthropic.claude-code",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "bierner.markdown-mermaid",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "ms-playwright.playwright",
        // ── Go ────────────────────────────────────────────────────────
        "golang.go",
        // ── Vue ───────────────────────────────────────────────────────
        "Vue.volar",
        // ── React / JS / TS ───────────────────────────────────────────
        "dbaeumer.vscode-eslint",
        "dsznajder.es7-react-js-snippets",
        "bradlc.vscode-tailwindcss",
        // ── Python ────────────────────────────────────────────────────
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.black-formatter",
        "ms-python.debugpy",
        "charliermarsh.ruff"
      ],
      "settings": {
        // ── Editor defaults ────────────────────────────────────────────
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.eslint": "explicit",
          "source.organizeImports": "explicit"
        },
        // ── Go ────────────────────────────────────────────────────────
        "go.useLanguageServer": true,
        "go.toolsManagement.autoUpdate": true,
        "go.lintTool": "golangci-lint",
        "go.formatTool": "goimports",
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        },
        // ── Python ────────────────────────────────────────────────────
        "python.analysis.typeCheckingMode": "strict",
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter",
          "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
          }
        },
        // ── Vue / TypeScript ──────────────────────────────────────────
        "[vue]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
        // Volar v2 uses Hybrid Mode by default — no takeover toggle needed.
        // Vue projects should set "vue.server.hybridMode": true (the default)
        // and rely on tsc for type-checking in CI.
        // ── Claude Code ───────────────────────────────────────────────
        "claude-code.allowDangerouslySkipPermissions": true,
        "claude-code.initialPermissionMode": "bypassPermissions",
        // ── Git ───────────────────────────────────────────────────────
        "github.gitAuthentication": false,
        "git.terminalAuthentication": false,
        // ── Terminal ──────────────────────────────────────────────────
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "bash", "icon": "terminal-bash" },
          "zsh": { "path": "zsh" }
        },
        // ── Performance ───────────────────────────────────────────────
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/bin/**": true,
          "**/.git/**": true,
          "**/.pytest_cache/**": true,
          "**/.venv/**": true,
          "**/.next/**": true,
          "**/.nuxt/**": true,
          "**/dist/**": true
        }
      }
    }
  },
  // Ports — adjust BACKEND_PORT in docker-compose.yml if 8091 collides.
  "forwardPorts": [
    1080,
    8091,
    5800
  ],
  // Lifecycle hooks:
  //   initialize.sh    — runs on HOST: auto-generates .env on first run
  //   post-create.sh   — baked in image at /usr/local/bin/
  //   post-start.sh    — baked in image at /usr/local/bin/
  // Consumers customize via optional .devcontainer/scripts/post-{create,start}-hook.sh.
  "initializeCommand": "bash .devcontainer/scripts/initialize.sh",
  "postCreateCommand": "bash /usr/local/bin/devcontainer-post-create.sh",
  "postStartCommand": "bash /usr/local/bin/devcontainer-post-start.sh",
  "waitFor": "postStartCommand"
}
