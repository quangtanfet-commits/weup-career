# Storybook 10's Vite builder pulls vite@8, but @vitejs/plugin-react@4
# (used by vitest.config.ts) still peers on vite<=7. The trees are
# compatible in practice — the validated frontend suite (vitest + storybook
# build + Playwright e2e) all pass against this resolution — so we accept the
# peer gap rather than force a plugin-react major bump that would re-open
# vitest 2.x compatibility. `npm ci` honours this so CI installs match local.
legacy-peer-deps=true
